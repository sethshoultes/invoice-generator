# Supabase Configuration
# For local Supabase (via Docker): http://localhost:54321
# For hosted Supabase: https://your-project.supabase.co
SUPABASE_URL=http://localhost:54321

# Supabase anonymous key (safe for client-side use)
SUPABASE_KEY=your-supabase-anon-key

# Supabase service role key (server-side only, has full access)
SUPABASE_SERVICE_KEY=your-supabase-service-key

# API Configuration
API_PORT=8002
ENVIRONMENT=development

# CORS Origins (comma-separated)
# Example: http://localhost:3002,http://localhost:8080
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
